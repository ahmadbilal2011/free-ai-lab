{
  "name": "Jarvis Live tools",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jarvis-live-tool",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1f0c1d2-0001-4a1b-9c01-000000000001",
      "name": "From Jarvis",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "jarvis-live-tool"
    },
    {
      "parameters": {
        "mode": "expression",
        "numberOutputs": 6,
        "output": "={{ Math.max(0, ['telegram','calendar','email','sar','automation'].indexOf($json.body.agent)) + (['telegram','calendar','email','sar','automation'].includes($json.body.agent) ? 0 : 5) }}"
      },
      "id": "a1f0c1d2-0002-4a1b-9c01-000000000002",
      "name": "Which agent",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [240, 300]
    },
    {
      "parameters": {
        "chatId": "PUT-YOUR-TELEGRAM-ID-HERE",
        "text": "={{ $json.body.args.text || $json.body.task }}",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "a1f0c1d2-0003-4a1b-9c01-000000000003",
      "name": "Messenger: send to Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, result: 'Sent to Telegram.' }) }}",
        "options": {}
      },
      "id": "a1f0c1d2-0004-4a1b-9c01-000000000004",
      "name": "Reply: sent",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [780, 0]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, result: 'The ' + $json.body.agent + ' agent is not connected yet. It gets built in a later lesson.' }) }}",
        "options": {}
      },
      "id": "a1f0c1d2-0005-4a1b-9c01-000000000005",
      "name": "Reply: not built yet",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 360]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'unknown agent' }) }}",
        "options": {}
      },
      "id": "a1f0c1d2-0006-4a1b-9c01-000000000006",
      "name": "Reply: unknown",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [520, 600]
    }
  ],
  "connections": {
    "From Jarvis": { "main": [[{ "node": "Which agent", "type": "main", "index": 0 }]] },
    "Which agent": {
      "main": [
        [{ "node": "Messenger: send to Telegram", "type": "main", "index": 0 }],
        [{ "node": "Reply: not built yet", "type": "main", "index": 0 }],
        [{ "node": "Reply: not built yet", "type": "main", "index": 0 }],
        [{ "node": "Reply: not built yet", "type": "main", "index": 0 }],
        [{ "node": "Reply: not built yet", "type": "main", "index": 0 }],
        [{ "node": "Reply: unknown", "type": "main", "index": 0 }]
      ]
    },
    "Messenger: send to Telegram": { "main": [[{ "node": "Reply: sent", "type": "main", "index": 0 }]] }
